+// hybrid: uploads experts to the cache in small chunks on its own stream, one chunk in flight at a time,
+// so the small transfers of the compute stream never queue behind a whole expert on the copy engine
+struct moe_cache_uploader {
+    struct copy {
+        ggml_tensor * bank;
+        const void  * src;
+        size_t offset;
+        size_t size;
+    };
+    struct batch {
+        std::vector<copy> copies;
+        uint64_t id;
+    };
+
+    ggml_backend_ptr backend;
+    ggml_backend_event_t event = nullptr;
+    size_t chunk;
+
+    std::atomic<uint64_t> completed { 0 }; // batches finish in order
+    std::atomic<size_t>   queued    { 0 }; // bytes not uploaded yet
+
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::deque<batch> batches;
+    bool stop = false;
+    std::thread thread;
+
+    moe_cache_uploader(ggml_backend_dev_t dev, size_t chunk) : chunk(chunk) {
+        backend.reset(ggml_backend_dev_init(dev, nullptr));
+        if (!backend) {
+            throw std::runtime_error("failed to create the MoE cache upload backend");
+        }
+        ggml_backend_dev_props props;
+        ggml_backend_dev_get_props(dev, &props);
+        if (props.caps.events) {
+            event = ggml_backend_event_new(dev);
+        }
+        thread = std::thread([this] { run(); });
+    }
+
+    ~moe_cache_uploader() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stop = true;
+        }
+        cv.notify_one();
+        thread.join();
+        if (event) {
+            ggml_backend_event_free(event);
+        }
+    }
+
+    void push(batch && b, size_t bytes) {
+        queued += bytes;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            batches.push_back(std::move(b));
+        }
+        cv.notify_one();
+    }
+
+    void run() {
+        for (;;) {
+            batch b;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                cv.wait(lock, [this] { return stop || !batches.empty(); });
+                if (batches.empty()) {
+                    return;
+                }
+                b = std::move(batches.front());
+                batches.pop_front();
+            }
+            for (const copy & c : b.copies) {
+                for (size_t off = 0; off < c.size; off += chunk) {
+                    const size_t n = std::min(chunk, c.size - off);
+                    ggml_backend_tensor_set_async(backend.get(), c.bank, (const uint8_t *) c.src + off, c.offset + off, n);
+                    if (event) {
+                        ggml_backend_event_record(event, backend.get());
+                        ggml_backend_event_synchronize(event);
+                    } else {
+                        ggml_backend_synchronize(backend.get());
+                    }
+                    queued -= n;
+                }
+            }
+            completed.store(b.id, std::memory_order_release);
+        }
+    }
+};
+
 }
 
