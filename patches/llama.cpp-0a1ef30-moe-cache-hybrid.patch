 10 files changed, 507 insertions(+), 178 deletions(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index 267b848..e4d161e 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2787,6 +2787,13 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.moe_cache_size = (size_t) value*1024*1024;
         }
     ).set_env("LLAMA_ARG_MOE_CACHE_MIB"));
+    add_opt(common_arg(
+        {"--moe-cache-hybrid"},
+        "with --moe-cache-mib: run the experts missing from the cache on the CPU and upload them in the background, instead of uploading them before the layer runs (default: false)",
+        [](common_params & params) {
+            params.moe_cache_hybrid = true;
+        }
+    ).set_env("LLAMA_ARG_MOE_CACHE_HYBRID"));
     add_opt(common_arg(
         {"-ncffn", "--n-cpu-ffn"}, "N",
         "keep the dense FFN weights of the first N layers in the CPU\n"
